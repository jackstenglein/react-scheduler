{
  "name": "@jackstenglein/react-scheduler",
  "version": "5.0.0",
  "description": "React scheduler component based on Material-UI & date-fns",
  "files": [
    "index.js",
    "**/*.d.ts",
    "!src/**"
  ],
  "type": "module",
  "scripts": {
    "start": "vite serve",
    "build": "vite build --mode production",
    "postbuild": "node ./scripts/post-pack.js",
    "local:pack": "npm run build && cd dist && npm pack && mv *.tgz ../",
    "format": "prettier --check \"**/*.{js,jsx,ts,tsx,json}\"",
    "format:write": "prettier --write \"**/*.{js,jsx,ts,tsx,json}\"",
    "lint": "npm run types && eslint .",
    "lint:fix": "eslint . --fix",
    "types": "tsc --noEmit",
    "prepare": "husky install",
    "pre:commit": "lint-staged",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "test:all": "vitest run",
    "bench": "vitest bench --run",
    "bench:baseline": "vitest bench --run --outputJson benchmarks/baseline.json",
    "bench:compare": "vitest bench --run --compare benchmarks/baseline.json"
  },
  "exports": {
    "./types": {
      "import": "./types.d.ts"
    },
    ".": {
      "import": "./index.js"
    }
  },
  "lint-staged": {
    "**/*.{ts,js,tsx,jsx}": [
      "npm run lint"
    ],
    "**/*.{ts,js,tsx,jsx,json,yml}": [
      "npm run format:write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jackstenglein/react-scheduler.git"
  },
  "keywords": [
    "react",
    "material-ui",
    "calendar",
    "scheduler"
  ],
  "author": "Jack Stenglein",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jackstenglein/react-scheduler/issues"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.20.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/x-date-pickers": "^9.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/rollup-plugin-peer-deps-external": "^2.2.6",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.9",
    "date-fns": "^4.4.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rrule": "^2.8.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.4.3",
    "vite-plugin-checker": "^0.9.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@mui/icons-material": ">=7.0.0",
    "@mui/material": ">=7.0.0",
    "@mui/x-date-pickers": ">=8.0.0",
    "date-fns": ">=4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "rrule": ">=2.8.1"
  },
  "peerDependenciesMeta": {
    "rrule": {
      "optional": true
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
